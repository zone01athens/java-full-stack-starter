<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>gr.zone01.athens</groupId>
    <artifactId>java-full-stack-starter</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>exercise-parent</artifactId>
  <packaging>pom</packaging>
  <properties>
    <piscine.exercise>${project.artifactId}</piscine.exercise>
    <piscine.runner>${project.basedir}/../tools/test-exercise</piscine.runner>
  </properties>
  <build>
    <sourceDirectory>${project.basedir}</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <includes><include>*.java</include></includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
